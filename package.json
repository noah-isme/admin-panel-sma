{
  "name": "admin-panel-sma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "20.x"
  },
  "pnpm": {
    "overrides": {
      "@smithy/config-resolver": "4.7.2",
      "brace-expansion": "2.1.4",
      "fast-xml-parser": "5.7.0",
      "follow-redirects": "1.16.0",
      "form-data": "4.0.6",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "minimatch": "5.1.8",
      "@ant-design/pro-layout>path-to-regexp": "8.4.0",
      "qs": "6.15.3",
      "uuid": "11.1.1",
      "yaml": "1.10.3"
    }
  },
  "scripts": {
    "dev": "concurrently -n admin,landing -c cyan,yellow \"pnpm --filter @apps/admin dev\" \"pnpm --filter @apps/landing dev\"",
    "dev:admin": "pnpm --filter @apps/admin dev",
    "dev:landing": "pnpm --filter @apps/landing dev",
    "dev:portal": "pnpm --filter @apps/portal dev",
    "build": "pnpm -r build",
    "build:vercel": "bash scripts/vercel-build.sh",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "format": "pnpm -r format",
    "prepare": "husky install",
    "print-superadmin": "node scripts/print-superadmin.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "22.5.4",
    "@typescript-eslint/eslint-plugin": "8.5.0",
    "@typescript-eslint/parser": "8.5.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "8.2.2",
    "cross-env": "7.0.3",
    "eslint": "9.9.0",
    "eslint-config-prettier": "9.1.0",
    "husky": "9.0.11",
    "jsdom": "26.1.0",
    "lint-staged": "15.2.7",
    "playwright": "^1.61.1",
    "prettier": "3.3.3",
    "supertest": "7.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.44.1",
    "vitest": "3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "msw": "^2.11.5",
    "zod": "3.23.8"
  }
}
