{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @apps/shared build && pnpm --filter @apps/landing build && pnpm --filter @apps/admin build && rm -rf deploy && mkdir -p deploy/admin && cp -r apps/landing/dist/* deploy/ && cp -r apps/admin/dist/* deploy/admin/",
  "outputDirectory": "deploy",
  "installCommand": "pnpm install",
  "rewrites": [
    { "handle": "filesystem" },
    { "source": "/admin/(.*)", "destination": "/admin/index.html" },
    { "source": "/((?!admin/).*)", "destination": "/index.html" }
  ],
  "env": {
    "VITE_BASE_PATH": "/admin/"
  },
  "preview": {
    "env": {
      "VITE_ENABLE_MSW": "true",
      "VITE_USE_MSW": "true"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
