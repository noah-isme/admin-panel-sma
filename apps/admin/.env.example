# Copy this file to .env and update VITE_API_URL for your environment.
# For Vercel deployment, set VITE_API_URL in Vercel Project Settings
# instead of modifying this file.
VITE_API_URL=http://localhost:8081/api/v1

# "All-On" mode for production: enables all feature-flagged modules at once
# When set to true, all individual feature flags below are enabled automatically
VITE_ENABLE_ALL_FEATURES=false

# These must match the corresponding ENABLE_* flags in sma-adp-api.
# Optional API capabilities default to disabled when omitted.
VITE_ENABLE_DASHBOARD=true
VITE_ENABLE_CALENDAR_ALIAS=true
VITE_ENABLE_ATTENDANCE_ALIAS=true
VITE_ENABLE_HOMEROOMS=true
VITE_ENABLE_CONFIGURATION_API=true
VITE_ENABLE_SCHEDULER=true
VITE_ENABLE_MUTATIONS=true
VITE_ENABLE_ARCHIVES=true
VITE_ENABLE_REPORTS=true
