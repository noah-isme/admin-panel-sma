NODE_ENV=development
TZ=Asia/Jakarta

# Go API (sma-adp-api) runs in a separate repo on port 8081.
# Configure JWT secrets, argon2, CORS, and auth lockout in ../sma-adp-api/.env
# (see that repo's .env.example). Those vars are NOT used by this monorepo.

# Worker (apps/worker) + shared DB access
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME
REDIS_URL=redis://:PASSWORD@HOST:6379

# Storage configuration (used by worker for report PDF / archives)
STORAGE_DRIVER=supabase # or r2
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=supabase-anon-key
SUPABASE_SERVICE_KEY=supabase-service-key
SUPABASE_BUCKET=public-assets
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Application URLs
APP_BASE_URL=http://localhost:5173
EMAIL_FROM=no-reply@example.local

# Admin frontend (apps/admin) — set these in apps/admin/.env, not the root .env:
#   VITE_API_URL=http://localhost:8081/api/v1
#   VITE_USE_MSW=true
#   VITE_STAGING=false (set true only for a real VPS staging build)
